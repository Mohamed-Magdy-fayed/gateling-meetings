# Postgres — local via `npm run db:start` (docker-compose.yml) or a Neon free-tier URL.
DATABASE_URL=""

# Upstash Redis — sessions + rate limiting. Free tier is plenty.
REDIS_URL=""
REDIS_TOKEN=""

# LiveKit — the media server. Either:
#   LiveKit Cloud (free tier, no server to run):  wss://<project>.livekit.cloud + the API key/secret from the dashboard
#   Self-hosted dev:  `npm run livekit` then ws://localhost:7880 with devkey / secret
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Inngest — set INNGEST_DEV=1 locally (with `npm run inngest`). Production uses the two keys instead.
INNGEST_DEV="1"
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# Absolute origin for emailed links + the OAuth callback. Defaults to localhost in dev; required in production.
BASE_URL=""
OAUTH_REDIRECT_URL_BASE=""

# Google sign-in (optional locally).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP for invites / verification emails. Leave blank and sendMail no-ops with a warning.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME=""

# Integration layer (other Gateling systems calling the REST API).
# JWT_SECRET_KEY signs /sso/join links — 32+ random chars (`openssl rand -base64 48`).
# ADMIN_EMAILS: comma-separated accounts allowed to open /settings/integrations.
JWT_SECRET_KEY=""
ADMIN_EMAILS=""

# Billing — Paymob (Egypt). Leave everything empty locally: the pricing page
# then shows the plans without a checkout and the webhook routes answer 503.
# Test and live keys are separate; test integration ids only work with the
# test secret key. PAYMOB_MODE is REQUIRED and never defaulted, so the app can
# never run test keys in production (or the reverse) by accident; a
# production deploy fails the build unless every value below is set and the
# mode is "live".
#
# BILLING_PROVIDER              "paymob" to enable billing; unset = no billing.
# PAYMOB_API_KEY                Dashboard → Developers → API key. Bearer auth
#                               for the plan / subscription endpoints.
# PAYMOB_SECRET_KEY             Dashboard → Developers → Secret key. Creates
#                               the payment intention (server only).
# PAYMOB_PUBLIC_KEY             Dashboard → Developers → Public key. Part of
#                               the unified-checkout URL the browser is sent to.
# PAYMOB_HMAC_SECRET            Dashboard → Developers → HMAC. Verifies the
#                               transaction / token callbacks.
# PAYMOB_CARD_INTEGRATION_ID    The online-card integration (EGP). Recurring
#                               deductions need a tokenised card, so wallets
#                               are not offered at checkout.
# PAYMOB_PLAN_ID_*              One Paymob subscription plan per paid plan and
#                               billing interval; `npx tsx
#                               scripts/seed-paymob-plans.ts` creates them and
#                               prints these lines. Test and live ids differ.
# PAYMOB_SUBSCRIPTION_WEBHOOK_TOKEN
#                               Any long random string (`openssl rand -hex 24`).
#                               Paymob's plan-level subscription webhook has no
#                               signature, so it is only reachable at
#                               /api/billing/webhook/paymob/subscription/<token>
#                               and the subscription is re-read from the API
#                               before anything is applied. The transaction
#                               callback (HMAC-signed) posts to
#                               /api/billing/webhook/paymob/transaction — set it
#                               as the integration's "transaction processed
#                               callback" in the dashboard. Paymob needs a
#                               public https URL, so callbacks are tested on the
#                               preview deployment, not locally.
BILLING_PROVIDER=""
PAYMOB_API_KEY=""
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_MODE="test"
PAYMOB_CARD_INTEGRATION_ID=""
PAYMOB_PLAN_ID_PRO_MONTH=""
PAYMOB_PLAN_ID_PRO_YEAR=""
PAYMOB_PLAN_ID_BUSINESS_MONTH=""
PAYMOB_PLAN_ID_BUSINESS_YEAR=""
PAYMOB_SUBSCRIPTION_WEBHOOK_TOKEN=""
