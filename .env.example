# Postgres — local via `npm run db:start` (docker-compose.yml) or a Neon free-tier URL.
DATABASE_URL=""

# Upstash Redis — sessions + rate limiting. Free tier is plenty.
REDIS_URL=""
REDIS_TOKEN=""

# LiveKit — the media server. Either:
#   LiveKit Cloud (free tier, no server to run):  wss://<project>.livekit.cloud + the API key/secret from the dashboard
#   Self-hosted dev:  `npm run livekit` then ws://localhost:7880 with devkey / secret
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Inngest — set INNGEST_DEV=1 locally (with `npm run inngest`). Production uses the two keys instead.
INNGEST_DEV="1"
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# Absolute origin for emailed links + the OAuth callback. Defaults to localhost in dev; required in production.
BASE_URL=""
OAUTH_REDIRECT_URL_BASE=""

# Google sign-in (optional locally).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP for invites / verification emails. Leave blank and sendMail no-ops with a warning.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME=""

# Integration layer (other Gateling systems calling the REST API).
# JWT_SECRET_KEY signs /sso/join links — 32+ random chars (`openssl rand -base64 48`).
# ADMIN_EMAILS: comma-separated accounts allowed to open /settings/integrations.
JWT_SECRET_KEY=""
ADMIN_EMAILS=""

# Paddle (billing, merchant of record). Leave the key, secret and price ids
# empty locally: the pricing page then shows the plans without prices or a
# checkout. Sandbox and live are separate Paddle accounts with separate keys,
# price ids and webhook secrets — every value below changes when you switch.
#
# Both *_ENVIRONMENT values are REQUIRED and never defaulted: the app refuses
# to start without them, so it can never run against the wrong Paddle account
# by accident. In production both must be "production", the API key must not
# be a sandbox one (pdl_sdbx_…) and the client token must be a live one
# (live_…); the build fails otherwise.
#
# PADDLE_API_KEY        Developer tools → Authentication → API keys (server only,
#                       never shipped to the browser).
# PADDLE_WEBHOOK_SECRET Developer tools → Notifications → the destination that
#                       posts to https://<app>/api/paddle/webhook; shown once when
#                       the destination is created. Never recreate a live
#                       destination — that rotates the secret.
# PADDLE_PRICE_ID_*     Catalog → Products: one recurring per-seat price per plan
#                       and billing interval (`scripts/seed-paddle-catalog.ts`
#                       creates them). The pricing page previews all four
#                       through Paddle.js; live ids differ from sandbox ones.
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_ENVIRONMENT="sandbox"
PADDLE_PRICE_ID_PRO_MONTH=""
PADDLE_PRICE_ID_PRO_YEAR=""
PADDLE_PRICE_ID_BUSINESS_MONTH=""
PADDLE_PRICE_ID_BUSINESS_YEAR=""
# Paddle.js client-side token (Developer tools → Authentication → Client-side
# tokens): test_… for sandbox, live_… for production. Safe to expose.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"
